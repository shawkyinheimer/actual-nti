   ],
   "source": [
    "x = input('enter an even-lengthed word')\n",
    "x_even = x[::2]\n",
    "mid = len(x_even)//2\n",
    "first_half = x_even[mid:]\n",
    "second_half = x_even[:mid]\n",
    "reversed_half = first_half + second_half[::-1]\n",
    "message = reversed_half.upper()\n",
    "message"
   ]
  },
